{% extends 'shell.html.twig' %}
{% from '_partials/icons.html.twig' import icon %}

{% block title %}Carte des sites — RolTech GMAO{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('map') }}
{% endblock %}

{% block shell_body %}
<main class="rtn-page">
    {% include '_partials/breadcrumb.html.twig' with {
        items: [
            { label: 'Tunisie', url: path('map_index') }
        ]
    } only %}

    <header class="rtn-page-header">
        <div>
            <p class="rtn-eyebrow">Navigation géographique</p>
            <h1 class="rtn-page-title">
                {{ icon('map', 28) }}
                Carte des sites de production
            </h1>
            <p class="rtn-page-desc">Surveillance en temps réel de l'état opérationnel des sites en Tunisie.</p>
        </div>
        <div class="rtn-actions">
            {% if is_granted('ROLE_RESPONSABLE') %}
                <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('responsable_dashboard') }}" data-turbo="false">
                    {{ icon('layout-dashboard', 18) }}
                    Tableau de bord
                </a>
            {% elseif is_granted('ROLE_TECHNICIEN') %}
                <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('technicien_dashboard') }}" data-turbo="false">
                    {{ icon('layout-dashboard', 18) }}
                    Tableau de bord
                </a>
            {% endif %}
            <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('machine_list') }}" data-turbo="false">
                {{ icon('boxes', 18) }}
                Parc machines
            </a>
        </div>
    </header>

    <div class="rtn-card rtn-map-legend" style="margin-bottom: var(--rtn-space-md);">
        <strong>Légende de criticité :</strong>
        <span class="rtn-legend-item"><span class="rtn-legend-dot rtn-dot-red"></span> <strong>Critique / En panne</strong> (machine en arrêt ou panne critique ouverte)</span>
        <span class="rtn-legend-item"><span class="rtn-legend-dot rtn-dot-orange"></span> <strong>Maintenance requise</strong> (tâche échue ou proche)</span>
        <span class="rtn-legend-item"><span class="rtn-legend-dot rtn-dot-green"></span> <strong>Opérationnel</strong></span>
    </div>

    <section class="rtn-map-wrapper">
        <div id="rtn-map"
             data-sites="{{ sitesJson|e('html_attr') }}"
             data-geojson-url="{{ asset('tunisia.geojson') }}"
             data-turbo="false">
        </div>
    </section>
</main>
{% endblock %}
