{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Tableau de bord — GMAO Roltech{% endblock %}

{% block main %}
<style>
    /* All six KPI cards share one row; auto-fit wraps them on narrow screens. */
    .rtn-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 16px;
    }
    .rtn-stat-card,
    .rtn-info-card {
        border-radius: 16px;
        padding: 18px 20px;
        color: #eceff4;
        min-height: 92px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .rtn-stat-label,
    .rtn-info-label { font-size: 13px; font-weight: 600; opacity: 0.85; }
    .rtn-stat-value,
    .rtn-info-value { font-size: 30px; font-weight: 700; margin-top: 6px; }

    .rtn-stat-total { background: #4c566a; }
    .rtn-stat-service { background: #5e81ac; }
    .rtn-stat-panne { background: #bf616a; }
    .rtn-stat-maintenance { background: #d08770; }
    .rtn-info-card { background: #3b4252; }
</style>

<div class="rtn-stats-grid">
    <div class="rtn-stat-card rtn-stat-total">
        <div class="rtn-stat-label">Machines</div>
        <div class="rtn-stat-value">{{ totalMachines }}</div>
    </div>
    <div class="rtn-stat-card rtn-stat-service">
        <div class="rtn-stat-label">En service</div>
        <div class="rtn-stat-value">{{ machinesEnService }}</div>
    </div>
    <div class="rtn-stat-card rtn-stat-panne">
        <div class="rtn-stat-label">En panne</div>
        <div class="rtn-stat-value">{{ machinesEnPanne }}</div>
    </div>
    <div class="rtn-stat-card rtn-stat-maintenance">
        <div class="rtn-stat-label">En maintenance</div>
        <div class="rtn-stat-value">{{ machinesEnMaintenance }}</div>
    </div>
    <div class="rtn-info-card">
        <div class="rtn-info-label">Pannes ouvertes</div>
        <div class="rtn-info-value">{{ faultsOuvertes }}</div>
    </div>
    <div class="rtn-info-card">
        <div class="rtn-info-label">Interventions en cours</div>
        <div class="rtn-info-value">{{ interventionsEnCours }}</div>
    </div>
</div>

<div id="rtn-charts-root" class="rtn-charts-grid" data-context="dashboard"></div>

<script type="application/json" id="rtn-stats-embedded">{{ statsJson|raw }}</script>
{% endblock %}
