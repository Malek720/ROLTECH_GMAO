{% set raw = field.value %}
{% set map = field.customOptions.get('badgeMap', {}) %}
{% include 'components/status_badge.html.twig' with { status: raw, custom: map } only %}

<style>
    .rtn-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        background: color-mix(in srgb, var(--rtn-badge-color) 16%, white);
        color: var(--rtn-badge-color);
    }
    .ea-dark-scheme .rtn-badge {
        background: color-mix(in srgb, var(--rtn-badge-color) 28%, #2e3440);
        color: color-mix(in srgb, var(--rtn-badge-color) 70%, white);
    }
    .rtn-badge-icon {
        width: 24px; height: 24px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: var(--rtn-badge-color);
        color: white;
        font-size: 12px;
        flex-shrink: 0;
    }
</style>
