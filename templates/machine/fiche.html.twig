{% extends 'shell.html.twig' %}
{% from '_partials/icons.html.twig' import icon %}

{% block title %}Fiche {{ machine.serialNumber }} — RolTech GMAO{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap(['viewer', 'viewer-panel']) }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @media print {
            /* Only the useful information is printed: the machine identity and its QR code. */
            .rtn-bell, .rtn-topbar, .rtn-sidebar, .rtn-global-search, .rtn-actions, .rtn-fiche-edit-form, .rtn-toasts, .rtn-viewer-section, .rtn-viewer-layout { display: none !important; }
            .rtn-page, .rtn-card, .rtn-qr { background: #fff !important; color: #000 !important; box-shadow: none !important; border-color: #999 !important; }
            .rtn-qr { grid-template-columns: minmax(0, 1fr) 200px; }
            .rtn-qr-code svg { background: #fff; padding: 0; }
            .rtn-qr-print-title { display: block; grid-column: 1 / -1; margin: 0 0 6px; font-size: 1.1rem; font-weight: 700; color: #000; }
            .rtn-qr-url { color: #000; }
        }
    </style>
{% endblock %}

{% block shell_body %}
<main class="rtn-page rtn-responsable-page">
    {% include '_partials/breadcrumb.html.twig' with {
        items: [
            { label: 'Tunisie', url: path('map_index') },
            { label: machine.site ? machine.site.name : 'Site inconnu', url: machine.site ? path('site_show', {id: machine.site.id}) : null },
            { label: machine.location ?: 'Zone non renseignée' },
            { label: machine.name }
        ]
    } only %}

    <header class="rtn-page-header">
        <div>
            <p class="rtn-eyebrow">{{ machine.site }} · {{ machine.location ?: 'Zone non renseignée' }}</p>
            <h1 class="rtn-page-title">
                {{ icon('boxes', 28) }}
                {{ machine.name }}
            </h1>
            <p class="rtn-page-desc">Fiche technique détaillée, identifiant QR et commandes de maintenance.</p>
        </div>
        <div class="rtn-actions">
            <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('responsable_dashboard') }}" data-turbo="false">
                {{ icon('layout-dashboard', 18) }}
                Tableau de bord
            </a>
            <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('machine_list') }}" data-turbo="false">
                {{ icon('boxes', 18) }}
                Parc machines
            </a>
            <a class="rtn-btn rtn-btn-primary rtn-btn-sm" href="{{ path('responsable_manual_intervention', {id: machine.id}) }}" data-turbo="false">
                {{ icon('plus-circle', 18) }}
                Nouvelle intervention
            </a>
        </div>
    </header>

    <section class="rtn-card">
        <div class="rtn-page-heading">
            <div>
                <p class="rtn-eyebrow">Fiche machine</p>
                <h2>{{ machine.machineModel.name }}</h2>
            </div>
            {% include 'components/status_badge.html.twig' with {status: machine.machineModel.dataStatus} only %}
        </div>
        <dl class="rtn-detail-list">
            <dt>Modèle</dt><dd>{{ machine.machineModel.code }} — {{ machine.machineModel.name }}</dd>
            <dt>Charge maximale</dt><dd>{{ machine.machineModel.maxLoadKg is not null ? machine.machineModel.maxLoadKg ~ ' kg' : 'charge max. à confirmer' }}</dd>
            <dt>Numéro de série</dt><dd>{{ machine.serialNumber }}</dd>
            <dt>Site</dt><dd>{{ machine.site }}</dd>
            <dt>Zone</dt><dd>{{ machine.location ?: 'Non renseignée' }}</dd>
            <dt>Heures de fonctionnement</dt><dd>{{ machine.operatingHours|number_format(0, ',', ' ') }} h</dd>
        </dl>

        <div class="rtn-qr">
            <p class="rtn-qr-print-title">Fiche machine — {{ machine.name }} · N° de série {{ machine.serialNumber }}</p>
            <div>
                <p class="rtn-eyebrow">Déclaration de panne</p>
                <p class="rtn-qr-caption">Scannez ce code avec un téléphone pour ouvrir la déclaration de panne de cette machine.</p>
                <p class="rtn-qr-url">{{ qrUrl }}</p>
            </div>
            <div class="rtn-qr-code" data-qr-url="{{ qrUrl }}">{{ qrSvg|raw }}</div>
        </div>

        <form method="post" class="rtn-form rtn-form-grid rtn-fiche-edit-form">
            <input type="hidden" name="_token" value="{{ csrf_token('machine_edit_' ~ machine.id) }}">
            <label class="rtn-field">
                <span class="rtn-field-label">Numéro de série</span>
                <input class="rtn-input" name="serial_number" value="{{ machine.serialNumber }}" required>
                {% if errors.serial_number|default(null) %}<span class="rtn-field-error">{{ errors.serial_number }}</span>{% endif %}
            </label>
            <label class="rtn-field">
                <span class="rtn-field-label">Zone</span>
                <input class="rtn-input" name="location" value="{{ machine.location }}">
            </label>
            <label class="rtn-field">
                <span class="rtn-field-label">Statut</span>
                <select class="rtn-input" name="status" required>
                    <option value="en service" {% if machine.status == 'en service' %}selected{% endif %}>En service</option>
                    <option value="en panne" {% if machine.status == 'en panne' %}selected{% endif %}>En panne</option>
                    <option value="en maintenance" {% if machine.status == 'en maintenance' %}selected{% endif %}>En maintenance</option>
                </select>
                {% if errors.status|default(null) %}<span class="rtn-field-error">{{ errors.status }}</span>{% endif %}
            </label>
            <button class="rtn-btn rtn-btn-primary" type="submit">Enregistrer la fiche</button>
        </form>
    </section>

    <section class="rtn-card">
        <div class="rtn-card-header">
            <h2 class="rtn-card-title">
                {{ icon('boxes', 20) }}
                Modules et pièces
            </h2>
        </div>
        <div class="rtn-module-grid">
            {% for module in modules %}
                <article class="rtn-module-card">
                    <div class="rtn-page-heading">
                        <strong>{{ module.code }} — {{ module.name }}</strong>
                        {% include 'components/status_badge.html.twig' with {status: module.dataStatus} only %}
                    </div>
                    <small>Planche {{ module.planche }}{% if module.parent %} · Sous-module de {{ module.parent.code }}{% endif %}</small>
                    <ul>
                        {% for part in module.parts %}
                            <li>
                                {{ part.partNumber ?: 'référence à confirmer' }} — {{ part.description }}
                                {% include 'components/status_badge.html.twig' with {status: part.dataStatus} only %}
                            </li>
                        {% else %}
                            <li>Aucune pièce renseignée.</li>
                        {% endfor %}
                    </ul>
                </article>
            {% else %}
                <p>Aucun module pour ce modèle.</p>
            {% endfor %}
        </div>
    </section>

    <section class="rtn-card rtn-viewer-section">
        <div class="rtn-card-header">
            <h2 class="rtn-card-title">
                {{ icon('boxes', 20) }}
                Vue schématique 3D
            </h2>
        </div>
        {% include '_partials/machine_viewer.html.twig' with {
            machine: machine,
            canSeeTimeline: true
        } only %}
    </section>

    <section class="rtn-card">
        <div class="rtn-card-header">
            <h2 class="rtn-card-title">
                {{ icon('alert-triangle', 20) }}
                Pannes
            </h2>
        </div>
        {% for fault in machine.faults|sort((a, b) => b.reportedAt <=> a.reportedAt) %}
            <article class="rtn-item" style="padding: 12px 0; border-bottom: 1px solid var(--rtn-border);">
                <div class="rtn-item-body">
                    <strong>{{ fault.symptom ?: 'Autre' }} — {{ fault.description }}</strong>
                    <span class="rtn-item-desc">{{ fault.reportedAt|date('d/m/Y H:i') }} · {% include 'components/status_badge.html.twig' with {status: fault.severity} only %} {% include 'components/status_badge.html.twig' with {status: fault.status} only %}</span>
                </div>
                <div class="rtn-inline-actions">
                    {% if fault.status != 'resolue' %}
                        <form method="post" action="{{ path('responsable_fault_close', {id: fault.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('responsable_fault_close_' ~ fault.id) }}">
                            <button class="rtn-btn rtn-btn-secondary rtn-btn-sm" type="submit">Clôturer</button>
                        </form>
                    {% else %}
                        <form method="post" action="{{ path('responsable_fault_reopen', {id: fault.id}) }}" style="display:flex;gap:6px;">
                            <input type="hidden" name="_token" value="{{ csrf_token('responsable_fault_reopen_' ~ fault.id) }}">
                            <input class="rtn-input" name="reason" required placeholder="Raison de réouverture" aria-label="Raison de réouverture" style="padding:4px 8px;font-size:.85rem;">
                            <button class="rtn-btn rtn-btn-secondary rtn-btn-sm" type="submit">Réouvrir</button>
                        </form>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <div class="rtn-empty">
                <span class="rtn-empty-icon" aria-hidden="true">{{ icon('alert-triangle', 40) }}</span>
                <p>Aucune panne signalée.</p>
            </div>
        {% endfor %}
    </section>

    <section class="rtn-card">
        <div class="rtn-card-header">
            <h2 class="rtn-card-title">
                {{ icon('clipboard-list', 20) }}
                Planning actif
            </h2>
        </div>
        {% for schedule in upcomingSchedules %}
            <article class="rtn-item" style="padding: 12px 0; border-bottom: 1px solid var(--rtn-border);">
                <div class="rtn-item-body">
                    <strong>{{ schedule.task.action }}</strong>
                    <span class="rtn-item-desc">Échéance : {{ schedule.nextDueDate|date('d/m/Y') }} · {{ schedule.nextDueHours }} h</span>
                </div>
                <div class="rtn-inline-actions" style="display:flex;align-items:center;gap:8px;">
                    {% include 'components/status_badge.html.twig' with {status: schedule.state} only %}
                    {% if schedule.state == 'echue' %}
                        <form method="post" action="{{ path('responsable_schedule_postpone', {id: schedule.id}) }}" style="display:flex;gap:6px;">
                            <input type="hidden" name="_token" value="{{ csrf_token('responsable_schedule_postpone_' ~ schedule.id) }}">
                            <input class="rtn-input" type="date" name="new_date" required aria-label="Nouvelle date de report" style="padding:4px 8px;font-size:.85rem;">
                            <input class="rtn-input" name="reason" required placeholder="Raison" aria-label="Raison du report" style="padding:4px 8px;font-size:.85rem;">
                            <button class="rtn-btn rtn-btn-secondary rtn-btn-sm" type="submit">Reporter</button>
                        </form>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <div class="rtn-empty">
                <span class="rtn-empty-icon" aria-hidden="true">{{ icon('clipboard-list', 40) }}</span>
                <p>Aucun planning actif.</p>
            </div>
        {% endfor %}
    </section>

    <section class="rtn-card">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <h2 style="margin: 0;">Chronologie{% if selectedModule %} — Module : {{ selectedModule.name }}{% endif %}</h2>
            {% if selectedModule %}
                <a href="{{ path('machine_fiche', {id: machine.id}) }}" class="rtn-btn rtn-btn-secondary rtn-btn-sm">Afficher tout</a>
            {% endif %}
        </div>
        <ol class="rtn-timeline" style="margin-top: 15px;">
            {% for event in timeline %}
                <li>
                    <time>{{ event.date|date('d/m/Y H:i') }}</time>
                    <div>
                        <strong>{{ event.kind }}</strong>
                        <span>{{ event.label }}</span>
                        {% include 'components/status_badge.html.twig' with {status: event.status} only %}
                    </div>
                </li>
            {% else %}
                <li>Aucun événement enregistré.</li>
            {% endfor %}
        </ol>
    </section>
</main>
{% endblock %}
