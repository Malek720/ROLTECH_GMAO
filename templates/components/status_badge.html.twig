{% set status = status|default('') %}
{% set defaults = {
    'en service': { icon: 'fa-circle-check', variant: 'ok', label: 'En service' },
    'en panne': { icon: 'fa-triangle-exclamation', variant: 'echue', label: 'En panne' },
    'en maintenance': { icon: 'fa-screwdriver-wrench', variant: 'proche', label: 'En maintenance' },
    'critique': { icon: 'fa-circle-exclamation', variant: 'echue', label: 'Critique' },
    'moyenne': { icon: 'fa-triangle-exclamation', variant: 'proche', label: 'Moyenne' },
    'faible': { icon: 'fa-circle-info', variant: 'info', label: 'Faible' },
    'ouverte': { icon: 'fa-circle-exclamation', variant: 'echue', label: 'Ouverte' },
    'resolue': { icon: 'fa-circle-check', variant: 'ok', label: 'Résolue' },
    'planifiee': { icon: 'fa-calendar-plus', variant: 'info', label: 'Planifiée' },
    'en cours': { icon: 'fa-person-running', variant: 'proche', label: 'En cours' },
    'terminee': { icon: 'fa-circle-check', variant: 'ok', label: 'Terminée' },
    'preventive': { icon: 'fa-shield-halved', variant: 'info', label: 'Préventive' },
    'curative': { icon: 'fa-wrench', variant: 'proche', label: 'Curative' },
    'ok': { icon: 'fa-circle-check', variant: 'ok', label: 'OK' },
    'proche': { icon: 'fa-clock', variant: 'warning', label: 'Proche' },
    'echue': { icon: 'fa-circle-exclamation', variant: 'echue', label: 'Échue' },
    'confirmed': { icon: 'fa-shield-check', variant: 'confirmed', label: 'Données confirmées' },
    'demo': { icon: 'fa-flask', variant: 'demo', label: 'Données de démonstration' }
} %}
{% set custom = custom|default({}) %}
{% set entry = custom[status] ?? defaults[status] ?? { icon: 'fa-circle-question', variant: 'default', label: status } %}
{% set variant = entry.variant ?? 'default' %}
<span class="rtn-badge rtn-badge-{{ variant }}"{% if entry.color is defined %} style="--rtn-badge-color: {{ entry.color }};"{% endif %}>
    <span class="rtn-badge-icon"><i class="fa {{ entry.icon }}"></i></span>
    {{ entry.label }}
</span>
