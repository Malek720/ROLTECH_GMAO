{% extends 'shell.html.twig' %}
{% from '_partials/icons.html.twig' import icon %}

{% block title %}Dispatch des interventions — RolTech GMAO{% endblock %}

{% block shell_body %}
<main class="rtn-page rtn-responsable-page">
    <header class="rtn-page-header">
        <div>
            <p class="rtn-eyebrow">Affectation des équipes</p>
            <h1 class="rtn-page-title">
                {{ icon('git-pull-request', 28) }}
                Dispatch des interventions
            </h1>
            <p class="rtn-page-desc">Assignation des techniciens de maintenance par site selon charge et criticité.</p>
        </div>
        <div class="rtn-actions">
            <a class="rtn-btn rtn-btn-secondary rtn-btn-sm rtn-button rtn-button-large" href="{{ path('responsable_dashboard') }}" data-turbo="false">
                {{ icon('layout-dashboard', 18) }}
                Tableau de bord
            </a>
            <a class="rtn-btn rtn-btn-primary rtn-btn-sm rtn-button rtn-button-large" href="{{ path('fault_new') }}" data-turbo="false">
                {{ icon('plus-circle', 18) }}
                Déclarer une panne
            </a>
        </div>
    </header>

    <section class="rtn-card">
        <p class="rtn-field-hint" style="margin-bottom:16px;">Les interventions sont classées par gravité puis par ancienneté. Les techniciens proposés appartiennent au site de la machine.</p>
        <div class="rtn-dispatch-list" style="display:flex;flex-direction:column;gap:16px;">
            {% for intervention in interventions %}
                {% set machine = intervention.fault ? intervention.fault.machine : intervention.schedule.machine %}
                <article class="rtn-dispatch-card" style="padding:16px;border:1px solid var(--rtn-border);border-radius:var(--rtn-radius-md);background:var(--rtn-bg-surface);">
                    <div class="rtn-page-heading" style="margin:0 0 10px;">
                        <div>
                            <p class="rtn-eyebrow">{{ machine.site.name }} · {{ intervention.type|capitalize }}</p>
                            <h2 style="font-size:1.15rem;margin:2px 0 4px;">{{ machine }}</h2>
                            <p style="margin:0;color:var(--rtn-text-muted);">{{ intervention.fault ? intervention.fault.description : intervention.schedule.task.action }}</p>
                        </div>
                        {% include 'components/status_badge.html.twig' with {status: intervention.fault ? intervention.fault.severity : 'proche'} only %}
                    </div>
                    <p class="rtn-field-hint" style="margin-bottom:12px;">Créée le {{ intervention.startDate|date('d/m/Y H:i') }} · {% if intervention.technician %}Affectée à {{ intervention.technician.fullName }}{% else %}Non affectée{% endif %}</p>
                    <form method="post" action="{{ path('responsable_dispatch_assign', {id: intervention.id}) }}" class="rtn-dispatch-form" style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
                        <input type="hidden" name="_token" value="{{ csrf_token('responsable_assign_' ~ intervention.id) }}">
                        <label class="rtn-field" style="flex:1;min-width:240px;margin:0;">
                            <span class="rtn-field-label">Technicien</span>
                            <select name="technician" class="rtn-input" required>
                                <option value="">Choisir un technicien</option>
                                {% for candidate in techniciansByIntervention[intervention.id]|default([]) %}
                                    <option value="{{ candidate.technician.id }}" {% if intervention.technician and intervention.technician.id == candidate.technician.id %}selected{% endif %}>{{ candidate.technician.fullName }} — {{ candidate.openCount }} ouverte(s)</option>
                                {% endfor %}
                            </select>
                        </label>
                        <button class="rtn-btn rtn-btn-primary rtn-button rtn-button-large" type="submit" style="min-height:44px;">
                            {{ icon('git-pull-request', 18) }}
                            {% if intervention.technician %}Réaffecter{% else %}Affecter{% endif %}
                        </button>
                    </form>
                </article>
            {% else %}
                <div class="rtn-empty">
                    <span class="rtn-empty-icon" aria-hidden="true">{{ icon('git-pull-request', 40) }}</span>
                    <p>Aucune intervention planifiée à dispatcher.</p>
                </div>
            {% endfor %}
        </div>
    </section>
</main>
{% endblock %}
