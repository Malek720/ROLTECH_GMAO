{% extends 'shell.html.twig' %}
{% from '_partials/icons.html.twig' import icon %}

{% block title %}Nouvelle intervention — RolTech GMAO{% endblock %}

{% block shell_body %}
<main class="rtn-page rtn-responsable-page">
    <header class="rtn-page-header">
        <div>
            <p class="rtn-eyebrow">{{ machine.site }} · {{ machine }}</p>
            <h1 class="rtn-page-title">
                {{ icon('plus-circle', 28) }}
                Créer une intervention
            </h1>
            <p class="rtn-page-desc">Planification manuelle d'une intervention préventive ou curative sur cet équipement.</p>
        </div>
        <div class="rtn-actions">
            <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('machine_fiche', {id: machine.id}) }}" data-turbo="false">
                Retour à la fiche
            </a>
            <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('responsable_dashboard') }}" data-turbo="false">
                {{ icon('layout-dashboard', 18) }}
                Tableau de bord
            </a>
        </div>
    </header>

    <section class="rtn-card">
        {% if errors.form|default(null) %}<p class="rtn-field-error" role="alert">{{ errors.form }}</p>{% endif %}
        <form method="post" class="rtn-form rtn-form-grid">
            <input type="hidden" name="intervention[_token]" value="{{ csrf_token('responsable_manual_intervention_' ~ machine.id) }}">
            <label class="rtn-field">
                <span class="rtn-field-label">Type</span>
                <select name="intervention[type]" class="rtn-input" required>
                    <option value="">Choisir</option>
                    <option value="preventive" {% if data.type|default('') == 'preventive' %}selected{% endif %}>Préventive</option>
                    <option value="curative" {% if data.type|default('') == 'curative' %}selected{% endif %}>Curative</option>
                </select>
            </label>
            <label class="rtn-field">
                <span class="rtn-field-label">Technicien</span>
                <select name="intervention[technician]" class="rtn-input">
                    <option value="">En attente d’affectation</option>
                    {% for technician in technicians %}<option value="{{ technician.id }}" {% if data.technician|default('') == technician.id %}selected{% endif %}>{{ technician.fullName }}</option>{% endfor %}
                </select>
            </label>
            <label class="rtn-field">
                <span class="rtn-field-label">Module</span>
                <select name="intervention[module]" class="rtn-input">
                    <option value="">Non précisé</option>
                    {% for module in modules %}<option value="{{ module.id }}" {% if data.module|default('') == module.id %}selected{% endif %}>{{ module.code }} — {{ module.name }}</option>{% endfor %}
                </select>
            </label>
            <label class="rtn-field">
                <span class="rtn-field-label">Tâche préventive</span>
                <select name="intervention[task]" class="rtn-input">
                    <option value="">Aucune</option>
                    {% for task in tasks %}<option value="{{ task.id }}" {% if data.task|default('') == task.id %}selected{% endif %}>{{ task.action }}</option>{% endfor %}
                </select>
            </label>
            <label class="rtn-field">
                <span class="rtn-field-label">Pièce</span>
                <select name="intervention[part]" class="rtn-input">
                    <option value="">Non précisée</option>
                    {% for module in modules %}{% for part in module.parts %}<option value="{{ part.id }}" {% if data.part|default('') == part.id %}selected{% endif %}>{{ part.partNumber ?: 'référence à confirmer' }} — {{ part.description }}</option>{% endfor %}{% endfor %}
                </select>
            </label>
            <label class="rtn-field">
                <span class="rtn-field-label">Gravité curative</span>
                <select name="intervention[severity]" class="rtn-input">
                    <option value="">Choisir</option><option value="critique">Critique</option><option value="moyenne">Moyenne</option><option value="faible">Faible</option>
                </select>
            </label>
            <label class="rtn-field rtn-form-field-full">
                <span class="rtn-field-label">Description curative</span>
                <textarea class="rtn-input" name="intervention[description]" rows="3" placeholder="Obligatoire pour une intervention curative">{{ data.description|default('') }}</textarea>
            </label>
            <div class="rtn-form-field-full" style="margin-top:16px;">
                <button class="rtn-btn rtn-btn-primary rtn-button rtn-button-large" type="submit">
                    {{ icon('plus-circle', 18) }}
                    Créer l’intervention
                </button>
            </div>
        </form>
    </section>
</main>
{% endblock %}
