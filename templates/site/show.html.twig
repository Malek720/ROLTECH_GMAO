{% extends 'base.html.twig' %}

{% block title %}Site {{ site.name }} — RolTech GMAO{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .rtn-zone-section {
            margin-bottom: 28px;
        }
        .rtn-zone-title {
            color: #88c0d0;
            font-size: 1.2rem;
            margin: 0 0 14px;
            padding-bottom: 8px;
            border-bottom: 1px solid #3b465c;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .rtn-machine-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 18px;
        }
        .rtn-site-machine-card {
            background: #1b2435;
            border: 1px solid #3b465c;
            border-radius: 12px;
            padding: 18px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .rtn-site-machine-card h3 {
            margin: 0;
            font-size: 1.1rem;
            color: #eceff4;
        }
        .rtn-card-meta {
            display: grid;
            gap: 6px;
            font-size: .88rem;
            color: #d8dee9;
        }
        .rtn-card-meta div {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }
        .rtn-card-actions {
            margin-top: auto;
            padding-top: 10px;
            border-top: 1px solid #3b465c;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
    </style>
{% endblock %}

{% block body %}
<main class="rtn-page">
    {% include '_partials/breadcrumb.html.twig' with {
        items: [
            { label: 'Tunisie', url: path('map_index') },
            { label: site.name }
        ]
    } only %}

    <header class="rtn-dashboard-header">
        <div>
            <p class="rtn-eyebrow">Site de production · {{ site.city }}</p>
            <h1>{{ site.name }}</h1>
        </div>
        <nav class="rtn-dashboard-actions">
            {% if is_granted('ROLE_RESPONSABLE') %}
                <a class="rtn-button rtn-button-large" href="{{ path('responsable_dashboard') }}" data-turbo="false">Tableau de bord</a>
            {% elseif is_granted('ROLE_TECHNICIEN') %}
                <a class="rtn-button rtn-button-large" href="{{ path('technicien_dashboard') }}" data-turbo="false">Tableau de bord</a>
            {% endif %}
            <a class="rtn-button rtn-button-large" href="{{ path('map_index') }}" data-turbo="false">Carte des sites</a>
            <a class="rtn-button rtn-button-large" href="{{ path('machine_list') }}" data-turbo="false">Parc machines</a>
        </nav>
    </header>

    {% for zone, machines in byZone %}
        <section class="rtn-card rtn-zone-section">
            <h2 class="rtn-zone-title">
                <span>📍 Zone : {{ zone }}</span>
                <span class="rtn-pill">{{ machines|length }} machine{{ machines|length > 1 ? 's' : '' }}</span>
            </h2>

            <div class="rtn-machine-grid">
                {% for machine in machines %}
                    {% set openFaults = machine.faults|filter(f => f.status != 'resolue') %}
                    {% set activeSchedules = machine.maintenanceSchedules|filter(s => s.archivedAt is null)|sort((a, b) => a.nextDueDate <=> b.nextDueDate) %}
                    {% set nextSchedule = activeSchedules|first %}

                    <article class="rtn-site-machine-card" data-machine-id="{{ machine.id }}">
                        <div class="rtn-page-heading" style="margin:0;">
                            <div>
                                <h3>{{ machine.name }}</h3>
                                <small style="color:#88c0d0;font-family:monospace;">{{ machine.serialNumber }}</small>
                            </div>
                            {% include 'components/status_badge.html.twig' with {status: machine.status} only %}
                        </div>

                        <div class="rtn-card-meta">
                            <div>
                                <span>Modèle :</span>
                                <span>
                                    <strong>{{ machine.machineModel.code }}</strong>
                                    {% include 'components/status_badge.html.twig' with {status: machine.machineModel.dataStatus} only %}
                                </span>
                            </div>
                            <div>
                                <span>Pannes ouvertes :</span>
                                {% if openFaults|length > 0 %}
                                    <strong style="color:#bf616a;">{{ openFaults|length }}</strong>
                                {% else %}
                                    <span style="color:#a3be8c;">Aucune</span>
                                {% endif %}
                            </div>
                            <div>
                                <span>Prochaine tâche :</span>
                                {% if nextSchedule %}
                                    <span>
                                        {{ nextSchedule.task.action }}
                                        <small style="color:#d8dee9;">({{ nextSchedule.nextDueDate|date('d/m/Y') }})</small>
                                        {% include 'components/status_badge.html.twig' with {status: nextSchedule.state} only %}
                                    </span>
                                {% else %}
                                    <span style="color:#d8dee9;">Aucun planning</span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="rtn-card-actions">
                            {% if is_granted('ROLE_RESPONSABLE') %}
                                <a class="rtn-button rtn-touch-link" href="{{ path('machine_fiche', {id: machine.id}) }}" data-turbo="false">Fiche machine</a>
                            {% endif %}
                            <a class="rtn-button rtn-button-secondary rtn-touch-link" href="{{ path('fault_new', {machine: machine.id}) }}" data-turbo="false">Déclarer panne</a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% else %}
        <section class="rtn-card">
            <p>Aucune machine enregistrée pour ce site.</p>
        </section>
    {% endfor %}
</main>
{% endblock %}
