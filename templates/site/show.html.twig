{% extends 'shell.html.twig' %}
{% from '_partials/icons.html.twig' import icon %}

{% block title %}Site {{ site.name }} — RolTech GMAO{% endblock %}

{% block shell_body %}
<main class="rtn-page">
    {% include '_partials/breadcrumb.html.twig' with {
        items: [
            { label: 'Tunisie', url: path('map_index') },
            { label: site.name }
        ]
    } only %}

    <header class="rtn-page-header">
        <div>
            <p class="rtn-eyebrow">Site de production · {{ site.city }}</p>
            <h1 class="rtn-page-title">
                {{ icon('map', 28) }}
                {{ site.name }}
            </h1>
            <p class="rtn-page-desc">Visualisation du parc machines et des zones de production de ce site.</p>
        </div>
        <div class="rtn-actions">
            {% if is_granted('ROLE_RESPONSABLE') %}
                <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('responsable_dashboard') }}" data-turbo="false">
                    {{ icon('layout-dashboard', 18) }}
                    Tableau de bord
                </a>
            {% elseif is_granted('ROLE_TECHNICIEN') %}
                <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('technicien_dashboard') }}" data-turbo="false">
                    {{ icon('layout-dashboard', 18) }}
                    Tableau de bord
                </a>
            {% endif %}
            <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('map_index') }}" data-turbo="false">
                {{ icon('map', 18) }}
                Carte des sites
            </a>
            <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('machine_list') }}" data-turbo="false">
                {{ icon('boxes', 18) }}
                Parc machines
            </a>
        </div>
    </header>

    {% for zone, machines in byZone %}
        <section class="rtn-card rtn-zone-section">
            <h2 class="rtn-zone-title">
                <span>📍 Zone : {{ zone }}</span>
                <span class="rtn-pill">{{ machines|length }} machine{{ machines|length > 1 ? 's' : '' }}</span>
            </h2>

            <div class="rtn-machine-grid">
                {% for machine in machines %}
                    {% set openFaults = machine.faults|filter(f => f.status != 'resolue') %}
                    {% set activeSchedules = machine.maintenanceSchedules|filter(s => s.archivedAt is null)|sort((a, b) => a.nextDueDate <=> b.nextDueDate) %}
                    {% set nextSchedule = activeSchedules|first %}

                    <article class="rtn-site-machine-card" data-machine-id="{{ machine.id }}">
                        <div class="rtn-page-heading" style="margin:0;">
                            <div>
                                <h3>{{ machine.name }}</h3>
                                <small style="color:var(--rtn-accent);font-family:monospace;">{{ machine.serialNumber }}</small>
                            </div>
                            {% include 'components/status_badge.html.twig' with {status: machine.status} only %}
                        </div>

                        <div class="rtn-card-meta">
                            <div>
                                <span>Modèle :</span>
                                <span>
                                    <strong>{{ machine.machineModel.code }}</strong>
                                    {% include 'components/status_badge.html.twig' with {status: machine.machineModel.dataStatus} only %}
                                </span>
                            </div>
                            <div>
                                <span>Pannes ouvertes :</span>
                                {% if openFaults|length > 0 %}
                                    <strong style="color:var(--rtn-status-echue-text);">{{ openFaults|length }}</strong>
                                {% else %}
                                    <span style="color:var(--rtn-status-ok);">Aucune</span>
                                {% endif %}
                            </div>
                            <div>
                                <span>Prochaine tâche :</span>
                                {% if nextSchedule %}
                                    <span>
                                        {{ nextSchedule.task.action }}
                                        <small style="color:var(--rtn-text-muted);">({{ nextSchedule.nextDueDate|date('d/m/Y') }})</small>
                                        {% include 'components/status_badge.html.twig' with {status: nextSchedule.state} only %}
                                    </span>
                                {% else %}
                                    <span style="color:var(--rtn-text-muted);">Aucun planning</span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="rtn-card-actions">
                            {% if is_granted('ROLE_RESPONSABLE') %}
                                <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('machine_fiche', {id: machine.id}) }}" data-turbo="false">Fiche machine</a>
                            {% endif %}
                            <a class="rtn-btn rtn-btn-primary rtn-btn-sm" href="{{ path('fault_new', {machine: machine.id}) }}" data-turbo="false">Déclarer panne</a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% else %}
        <section class="rtn-card">
            <div class="rtn-empty">
                <span class="rtn-empty-icon" aria-hidden="true">{{ icon('boxes', 40) }}</span>
                <p>Aucune machine enregistrée pour ce site.</p>
            </div>
        </section>
    {% endfor %}
</main>
{% endblock %}
