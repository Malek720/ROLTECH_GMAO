{% extends 'shell.html.twig' %}
{% from '_partials/icons.html.twig' import icon %}

{% block title %}Recherche — RolTech GMAO{% endblock %}

{% block shell_body %}
{% set backRoute = is_granted('ROLE_RESPONSABLE') ? 'responsable_dashboard' : 'technicien_dashboard' %}
<main class="rtn-page">
    <header class="rtn-page-header">
        <div>
            <p class="rtn-eyebrow">Recherche globale</p>
            <h1 class="rtn-page-title">
                {{ icon('search', 28) }}
                Recherche
            </h1>
            {% if term == '' or tooShort %}
                <p class="rtn-page-desc rtn-search-summary">Recherchez une machine par nom, numéro de série ou modèle, ou une intervention par numéro.</p>
            {% else %}
                <p class="rtn-page-desc rtn-search-summary">Résultat pour « {{ term }} ».</p>
            {% endif %}
        </div>
        <div class="rtn-actions">
            <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path(backRoute) }}" data-turbo="false">
                {{ icon('layout-dashboard', 18) }}
                Tableau de bord
            </a>
        </div>
    </header>

    {% if term == '' or tooShort %}
        <section class="rtn-card">
            <div class="rtn-empty">
                <span class="rtn-empty-icon" aria-hidden="true">{{ icon('search', 40) }}</span>
                <p class="rtn-search-hint">Saisissez au moins 2 caractères pour lancer la recherche.</p>
            </div>
        </section>
    {% else %}
        <section class="rtn-card">
            <div class="rtn-card-header">
                <h2 class="rtn-card-title">
                    {{ icon('boxes', 20) }}
                    Machines
                </h2>
            </div>
            {% if machines is empty %}
                <div class="rtn-empty">
                    <span class="rtn-empty-icon" aria-hidden="true">{{ icon('boxes', 40) }}</span>
                    <p class="rtn-search-empty">Aucun résultat.</p>
                </div>
            {% else %}
                <ul class="rtn-search-list">
                    {% for machine in machines %}
                        <li class="rtn-search-item" data-machine-id="{{ machine.id }}">
                            <strong>{{ machine.name }}</strong>
                            <small>N° de série : {{ machine.serialNumber ?: '—' }}</small>
                            <small>Modèle : {{ machine.machineModel ? machine.machineModel.code ~ ' — ' ~ machine.machineModel.name : '—' }}</small>
                            <small>Site : {{ machine.site ? machine.site.name : '—' }}</small>
                            <div class="rtn-search-badges">
                                {% include 'components/status_badge.html.twig' with {status: machine.status} only %}
                                {% include 'components/status_badge.html.twig' with {status: machine.machineModel.dataStatus} only %}
                            </div>
                            <div style="margin-top:8px;">
                                {% if is_granted('ROLE_RESPONSABLE') %}
                                    <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('machine_fiche', {id: machine.id}) }}" data-turbo="false">Ouvrir la fiche</a>
                                {% else %}
                                    <a class="rtn-btn rtn-btn-primary rtn-btn-sm" href="{{ path('fault_new', {machine: machine.id}) }}" data-turbo="false">Déclarer une panne</a>
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <section class="rtn-card">
            <div class="rtn-card-header">
                <h2 class="rtn-card-title">
                    {{ icon('wrench', 20) }}
                    Interventions
                </h2>
            </div>
            {% if interventions is empty %}
                <div class="rtn-empty">
                    <span class="rtn-empty-icon" aria-hidden="true">{{ icon('wrench', 40) }}</span>
                    <p class="rtn-search-empty">Aucun résultat.</p>
                </div>
            {% else %}
                <ul class="rtn-search-list">
                    {% for intervention in interventions %}
                        {% set target = intervention.fault ? intervention.fault.machine : (intervention.schedule ? intervention.schedule.machine : null) %}
                        <li class="rtn-search-item" data-intervention-id="{{ intervention.id }}">
                            <strong>Intervention #{{ intervention.id }}</strong>
                            <small>Machine : {{ target ? target.name : '—' }}</small>
                            <small>Date prévue : {{ intervention.startDate ? intervention.startDate|date('d/m/Y') : '—' }}</small>
                            <div class="rtn-search-badges">
                                {% include 'components/status_badge.html.twig' with {status: intervention.type} only %}
                                {% include 'components/status_badge.html.twig' with {status: intervention.status} only %}
                            </div>
                            <div style="margin-top:8px;">
                                <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('intervention_show', {id: intervention.id}) }}" data-turbo="false">Ouvrir l'intervention</a>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    {% endif %}
</main>
{% endblock %}
