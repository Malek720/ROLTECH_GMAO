{% extends 'base.html.twig' %}

{% block title %}Espace {{ roleLabel }}{% endblock %}

{% block body %}
<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #1a1f2b 0%, #2b3245 100%); font-family: 'Segoe UI', system-ui, sans-serif;">
    <div style="background: #f4f5f7; border-radius: 12px; padding: 48px; text-align: center; box-shadow: 0 20px 60px rgba(0,0,0,0.4);">
        <h1 style="color: #1a1f2b; margin-bottom: 8px;">Bienvenue, {{ roleLabel }}</h1>
        <p style="color: #6b7280;">Cet espace sera développé au sprint suivant.</p>
        <a href="{{ path('app_logout') }}" style="display: inline-block; margin-top: 24px; padding: 10px 24px; background: #2b3245; color: white; border-radius: 6px; text-decoration: none;">Se déconnecter</a>
    </div>
</div>
{% endblock %}
