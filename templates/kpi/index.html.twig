{% extends 'shell.html.twig' %}
{% from '_partials/icons.html.twig' import icon %}

{% block title %}Indicateurs KPI — RolTech GMAO{% endblock %}

{% block shell_body %}
<main class="rtn-page">
    <header class="rtn-page-header">
        <div>
            <p class="rtn-eyebrow">Indicateurs de performance</p>
            <h1 class="rtn-page-title">
                {{ icon('bar-chart-3', 28) }}
                Indicateurs KPI
            </h1>
            <p class="rtn-page-desc">Disponibilité des machines, MTTR et fréquence des pannes du parc.</p>
        </div>
        <div class="rtn-actions">
            <a class="rtn-btn rtn-btn-primary rtn-btn-sm" href="{{ path('kpi_export', {from: report.window.from, to: report.window.to}) }}" data-turbo="false">
                {{ icon('clipboard-list', 18) }}
                Exporter CSV
            </a>
            <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('responsable_dashboard') }}" data-turbo="false">
                {{ icon('layout-dashboard', 18) }}
                Tableau de bord
            </a>
        </div>
    </header>

    <section class="rtn-card">
        <form method="get" class="rtn-form rtn-kpi-filter">
            <div class="rtn-form-grid">
                <label class="rtn-field">
                    <span class="rtn-field-label">Du</span>
                    <input class="rtn-input" type="date" name="from" value="{{ report.window.from }}">
                </label>
                <label class="rtn-field">
                    <span class="rtn-field-label">Au</span>
                    <input class="rtn-input" type="date" name="to" value="{{ report.window.to }}">
                </label>
            </div>
            <button class="rtn-btn rtn-btn-secondary" type="submit" style="margin-top:12px;">Appliquer</button>
            <p class="rtn-kpi-period">
                Période analysée : du {{ report.window.from }} au {{ report.window.to }}{% if report.window.isDefault %} (période par défaut : 12 derniers mois){% endif %}.
            </p>
        </form>
    </section>

    <section class="rtn-card">
        <div class="rtn-card-header">
            <h2 class="rtn-card-title">
                {{ icon('boxes', 20) }}
                Disponibilité par machine
            </h2>
        </div>
        {% set availabilityByModel = {} %}
        {% for row in report.availability %}
            {% set modelKey = row.modelCode ?: '—' %}
            {% set availabilityByModel = availabilityByModel|merge({(modelKey): (availabilityByModel[modelKey]|default([]))|merge([row])}) %}
        {% endfor %}
        {% for modelCode, rows in availabilityByModel %}
            <h3 class="rtn-kpi-model">Modèle {{ modelCode }}</h3>
            <div class="rtn-table-scroll">
                <table class="rtn-kpi-table">
                    <caption>Disponibilité des machines du modèle {{ modelCode }}</caption>
                    <thead>
                        <tr><th scope="col">Machine</th><th scope="col">Site</th><th scope="col">Données</th><th scope="col">Indisponibilité (h)</th><th scope="col">Disponibilité</th></tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr>
                                <td>{{ row.machineName }}</td>
                                <td>{{ row.siteName ?: '—' }}</td>
                                <td>{% include 'components/status_badge.html.twig' with {status: row.dataStatus} only %}</td>
                                <td>{{ row.downtimeHours }}</td>
                                <td>{% if row.availability is null %}<span class="rtn-kpi-nd">n/d</span>{% else %}{{ row.availability }} %{% endif %}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="rtn-empty">
                <span class="rtn-empty-icon" aria-hidden="true">{{ icon('boxes', 40) }}</span>
                <p>Aucune machine à afficher pour cette période.</p>
            </div>
        {% endfor %}
        <p class="rtn-field-hint" style="margin-top:12px;">Disponibilité calculée sur les pannes critiques ; « n/d » quand la période d'observation est nulle (machine installée après la fin de la période).</p>
    </section>

    <section class="rtn-card">
        <div class="rtn-card-header">
            <h2 class="rtn-card-title">
                {{ icon('wrench', 20) }}
                Temps de réparation moyen
            </h2>
        </div>
        <div class="rtn-table-scroll">
            <table class="rtn-kpi-table">
                <thead>
                    <tr><th scope="col">Interventions curatives terminées</th><th scope="col">Total (h)</th><th scope="col">Temps moyen</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{ report.meanRepairTime.count }}</td>
                        <td>{{ report.meanRepairTime.totalHours }}</td>
                        <td>{% if report.meanRepairTime.meanHours is null %}<span class="rtn-kpi-nd">n/d</span>{% else %}{{ report.meanRepairTime.meanHours }} h{% endif %}</td>
                    </tr>
                </tbody>
            </table>
        </div>
        {% if report.meanRepairTime.count == 0 %}
            <div class="rtn-empty">
                <span class="rtn-empty-icon" aria-hidden="true">{{ icon('wrench', 40) }}</span>
                <p>Aucune intervention curative terminée sur la période.</p>
            </div>
        {% endif %}
    </section>

    <section class="rtn-card">
        <div class="rtn-card-header">
            <h2 class="rtn-card-title">
                {{ icon('map', 20) }}
                Pannes par site et par mois
            </h2>
        </div>
        <div class="rtn-table-scroll">
            <table class="rtn-kpi-table">
                <thead>
                    <tr><th scope="col">Site</th><th scope="col">Mois</th><th scope="col">Pannes</th></tr>
                </thead>
                <tbody>
                    {% for row in report.faultsPerSite %}
                        <tr><td>{{ row.group }}</td><td>{{ row.month }}</td><td>{{ row.count }}</td></tr>
                    {% else %}
                        <tr><td colspan="3"><div class="rtn-empty"><p>Aucune panne déclarée sur la période.</p></div></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="rtn-card">
        <div class="rtn-card-header">
            <h2 class="rtn-card-title">
                {{ icon('boxes', 20) }}
                Pannes par modèle et par mois
            </h2>
        </div>
        <div class="rtn-table-scroll">
            <table class="rtn-kpi-table">
                <thead>
                    <tr><th scope="col">Modèle</th><th scope="col">Données</th><th scope="col">Mois</th><th scope="col">Pannes</th></tr>
                </thead>
                <tbody>
                    {% for row in report.faultsPerModel %}
                        <tr>
                            <td>{{ row.group }}</td>
                            <td>{% include 'components/status_badge.html.twig' with {status: row.dataStatus} only %}</td>
                            <td>{{ row.month }}</td>
                            <td>{{ row.count }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4"><div class="rtn-empty"><p>Aucune panne déclarée sur la période.</p></div></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="rtn-card">
        <div class="rtn-card-header">
            <h2 class="rtn-card-title">
                {{ icon('bar-chart-3', 20) }}
                Graphiques
            </h2>
        </div>
        <p class="rtn-field-hint">Les graphiques ci-dessous complètent les tableaux ; ils se chargent seulement si la bibliothèque est disponible. Les tableaux restent la référence.</p>
        <div class="rtn-kpi-chart-grid" id="rtn-kpi-charts-root"></div>
    </section>
</main>

<script type="application/json" id="rtn-kpi-data">{{ chartData|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
<script src="{{ asset('kpi.js') }}"></script>
{% endblock %}
