{% extends 'base.html.twig' %}

{% block title %}Indicateurs KPI{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .rtn-kpi-filter{align-items:end}
        .rtn-kpi-period{margin:0;color:#d8dee9;font-size:.92rem}
        .rtn-table-scroll{overflow-x:auto;border:1px solid #3b465c;border-radius:10px}
        .rtn-kpi-table{width:100%;border-collapse:collapse;min-width:520px}
        .rtn-kpi-table caption{caption-side:top;text-align:left;padding:12px 16px;font-weight:700;color:#eceff4}
        .rtn-kpi-table th,.rtn-kpi-table td{padding:12px 16px;text-align:left;border-bottom:1px solid #3b465c;white-space:nowrap}
        .rtn-kpi-table tbody tr:last-child td{border-bottom:0}
        .rtn-kpi-table th{background:#1b2435;color:#eceff4;font-weight:700}
        .rtn-kpi-table td{color:#d8dee9}
        .rtn-kpi-nd{color:#9aa7ba;font-style:italic}
        .rtn-kpi-model{margin:22px 0 10px;color:#88c0d0;font-size:1.05rem}
        .rtn-kpi-chart-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:20px;margin-top:12px}
        .rtn-kpi-chart{min-height:280px}
        .rtn-empty{margin:14px 0 0;color:#9aa7ba}
        .rtn-kpi-error{margin:0;color:#ffb4ab}
    </style>
{% endblock %}

{% block body %}
<main class="rtn-page">
    <header class="rtn-page-heading">
        <div>
            <p class="rtn-eyebrow">RolTech GMAO</p>
            <h1>Indicateurs KPI</h1>
        </div>
        <nav class="rtn-dashboard-actions">
            <a class="rtn-button rtn-button-large" href="{{ path('kpi_export', {from: report.window.from, to: report.window.to}) }}" data-turbo="false">Exporter CSV</a>
            <a class="rtn-button rtn-button-large" href="{{ path('responsable_dashboard') }}" data-turbo="false">Retour</a>
        </nav>
    </header>

    <section class="rtn-card">
        <form method="get" class="rtn-form rtn-kpi-filter">
            <div class="rtn-form-grid">
                <label class="rtn-form-field">Du
                    <input type="date" name="from" value="{{ report.window.from }}">
                </label>
                <label class="rtn-form-field">Au
                    <input type="date" name="to" value="{{ report.window.to }}">
                </label>
            </div>
            <button class="rtn-button" type="submit">Appliquer</button>
            <p class="rtn-kpi-period">
                Période analysée : du {{ report.window.from }} au {{ report.window.to }}{% if report.window.isDefault %} (période par défaut : 12 derniers mois){% endif %}.
            </p>
        </form>
    </section>

    <section class="rtn-card">
        <h2>Disponibilité par machine</h2>
        {% set availabilityByModel = {} %}
        {% for row in report.availability %}
            {% set modelKey = row.modelCode ?: '—' %}
            {% set availabilityByModel = availabilityByModel|merge({(modelKey): (availabilityByModel[modelKey]|default([]))|merge([row])}) %}
        {% endfor %}
        {% for modelCode, rows in availabilityByModel %}
            <h3 class="rtn-kpi-model">Modèle {{ modelCode }}</h3>
            <div class="rtn-table-scroll">
                <table class="rtn-kpi-table">
                    <caption>Disponibilité des machines du modèle {{ modelCode }}</caption>
                    <thead>
                        <tr><th scope="col">Machine</th><th scope="col">Site</th><th scope="col">Données</th><th scope="col">Indisponibilité (h)</th><th scope="col">Disponibilité</th></tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr>
                                <td>{{ row.machineName }}</td>
                                <td>{{ row.siteName ?: '—' }}</td>
                                <td>{% include 'components/status_badge.html.twig' with {status: row.dataStatus} only %}</td>
                                <td>{{ row.downtimeHours }}</td>
                                <td>{% if row.availability is null %}<span class="rtn-kpi-nd">n/d</span>{% else %}{{ row.availability }} %{% endif %}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="rtn-empty">Aucune machine à afficher pour cette période.</p>
        {% endfor %}
        <p class="rtn-form-help">Disponibilité calculée sur les pannes critiques ; « n/d » quand la période d'observation est nulle (machine installée après la fin de la période).</p>
    </section>

    <section class="rtn-card">
        <h2>Temps de réparation moyen</h2>
        <div class="rtn-table-scroll">
            <table class="rtn-kpi-table">
                <thead>
                    <tr><th scope="col">Interventions curatives terminées</th><th scope="col">Total (h)</th><th scope="col">Temps moyen</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{ report.meanRepairTime.count }}</td>
                        <td>{{ report.meanRepairTime.totalHours }}</td>
                        <td>{% if report.meanRepairTime.meanHours is null %}<span class="rtn-kpi-nd">n/d</span>{% else %}{{ report.meanRepairTime.meanHours }} h{% endif %}</td>
                    </tr>
                </tbody>
            </table>
        </div>
        {% if report.meanRepairTime.count == 0 %}
            <p class="rtn-empty">Aucune intervention curative terminée sur la période.</p>
        {% endif %}
    </section>

    <section class="rtn-card">
        <h2>Pannes par site et par mois</h2>
        <div class="rtn-table-scroll">
            <table class="rtn-kpi-table">
                <thead>
                    <tr><th scope="col">Site</th><th scope="col">Mois</th><th scope="col">Pannes</th></tr>
                </thead>
                <tbody>
                    {% for row in report.faultsPerSite %}
                        <tr><td>{{ row.group }}</td><td>{{ row.month }}</td><td>{{ row.count }}</td></tr>
                    {% else %}
                        <tr><td colspan="3" class="rtn-empty">Aucune panne déclarée sur la période.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="rtn-card">
        <h2>Pannes par modèle et par mois</h2>
        <div class="rtn-table-scroll">
            <table class="rtn-kpi-table">
                <thead>
                    <tr><th scope="col">Modèle</th><th scope="col">Données</th><th scope="col">Mois</th><th scope="col">Pannes</th></tr>
                </thead>
                <tbody>
                    {% for row in report.faultsPerModel %}
                        <tr>
                            <td>{{ row.group }}</td>
                            <td>{% include 'components/status_badge.html.twig' with {status: row.dataStatus} only %}</td>
                            <td>{{ row.month }}</td>
                            <td>{{ row.count }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="rtn-empty">Aucune panne déclarée sur la période.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="rtn-card">
        <h2>Graphiques</h2>
        <p class="rtn-form-help">Les graphiques ci-dessous complètent les tableaux ; ils se chargent seulement si la bibliothèque est disponible. Les tableaux restent la référence.</p>
        <div class="rtn-kpi-chart-grid" id="rtn-kpi-charts-root"></div>
    </section>
</main>

<script type="application/json" id="rtn-kpi-data">{{ chartData|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
<script src="{{ asset('kpi.js') }}"></script>
{% endblock %}
