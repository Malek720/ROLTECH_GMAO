{% extends 'shell.html.twig' %}
{% from '_partials/icons.html.twig' import icon %}

{% block title %}Intervention — RolTech GMAO{% endblock %}

{% block shell_body %}
<main class="rtn-page">
    <header class="rtn-page-header">
        <div>
            <p class="rtn-eyebrow">Détail intervention</p>
            <h1 class="rtn-page-title">
                {{ icon('wrench', 28) }}
                Intervention
            </h1>
            <p class="rtn-page-desc">Prise en charge associée à la panne signalée.</p>
        </div>
        <div class="rtn-actions">
            <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('fault_confirmation', {id: intervention.fault.id}) }}" data-turbo="false">
                Retour à la panne
            </a>
            <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('faults_mine') }}" data-turbo="false">
                Mes pannes déclarées
            </a>
        </div>
    </header>

    <section class="rtn-card">
        <div class="rtn-card-header">
            <h2 class="rtn-card-title">
                {{ icon('clipboard-list', 20) }}
                Informations d'intervention
            </h2>
        </div>
        <dl class="rtn-detail-list">
            <dt>Type</dt><dd>{% include 'components/status_badge.html.twig' with {status: intervention.type} only %}</dd>
            <dt>Statut</dt><dd>{% include 'components/status_badge.html.twig' with {status: intervention.status} only %}</dd>
            <dt>Machine</dt><dd>{{ intervention.fault.machine }}</dd>
            <dt>Technicien</dt><dd>{{ intervention.technician ? intervention.technician.fullName : 'En attente d’affectation' }}</dd>
            <dt>Début prévu</dt><dd>{{ intervention.startDate|date('d/m/Y H:i') }}</dd>
        </dl>
        <div class="rtn-safety">
            <h2>Règles de sécurité</h2>
            <p>Couper et verrouiller les alimentations pneumatique et électrique avant toute intervention. Personnel qualifié uniquement. Utiliser des pièces originales ou validées par ROLTECH.</p>
        </div>
    </section>
</main>
{% endblock %}
