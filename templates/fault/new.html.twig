{% extends 'shell.html.twig' %}
{% from '_partials/icons.html.twig' import icon %}

{% block title %}Déclarer une panne — RolTech GMAO{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap(['viewer', 'viewer-panel']) }}
{% endblock %}

{% block shell_body %}
<main class="rtn-page">
    {% include '_partials/breadcrumb.html.twig' with {
        items: [
            { label: 'Tunisie', url: path('map_index') },
            { label: selectedMachine ? selectedMachine.site.name : null, url: selectedMachine and selectedMachine.site ? path('site_show', {id: selectedMachine.site.id}) : null },
            { label: selectedMachine ? selectedMachine.name : null },
            { label: 'Déclarer une panne' }
        ]
    } only %}

    <header class="rtn-page-header">
        <div>
            <p class="rtn-eyebrow">Assistance & maintenance</p>
            <h1 class="rtn-page-title">
                {{ icon('alert-triangle', 28) }}
                Déclarer une panne
            </h1>
            <p class="rtn-page-desc">Signaler un dysfonctionnement sur un équipement pour planifier une intervention.</p>
        </div>
        <div class="rtn-actions">
            <a class="rtn-btn rtn-btn-secondary rtn-btn-sm" href="{{ path('faults_mine') }}" data-turbo="false">
                {{ icon('alert-triangle', 18) }}
                Mes pannes déclarées
            </a>
        </div>
    </header>

    <section class="rtn-card">
        {% if errors.form|default(false) %}<p class="rtn-field-error" role="alert">{{ errors.form }}</p>{% endif %}
        <form method="post" class="rtn-form" data-turbo="false" id="rtn-fault-form">
            <input type="hidden" name="fault[_token]" value="{{ csrf_token('fault_declare') }}">
            <input type="hidden" name="fault[_submission_token]" value="{{ data._submission_token }}">
            <div class="rtn-form-grid">
                <label class="rtn-field">
                    <span class="rtn-field-label">Machine</span>
                    <select name="fault[machine]" id="rtn-fault-machine" class="rtn-input" required>
                        <option value="">Sélectionner</option>
                        {% for group in machineGroups %}
                            <optgroup label="{{ group.site }}">
                                {% for machine in group.machines %}<option value="{{ machine.id }}" data-viewer-url="{{ path('parc_machine_viewer_data', {id: machine.id}) }}" data-machine-model="{{ machine.machineModel.id }}" data-model-status="{{ machine.machineModel.dataStatus }}" {% if (selectedMachine and selectedMachine.id == machine.id) or data.machine|default('') == machine.id %}selected{% endif %}>{{ machine.machineModel.code }} — {{ machine }}</option>{% endfor %}
                            </optgroup>
                        {% endfor %}
                    </select>
                    {% if errors.machine|default(false) %}<span class="rtn-field-error">{{ errors.machine }}</span>{% endif %}
                    <span id="rtn-machine-model-badges" style="margin-top:4px;display:inline-block;">
                        {% for model in modelsById %}<span data-model-badge="{{ model.id }}" {% if selectedMachine is null or selectedMachine.machineModel.id != model.id %}hidden{% endif %}>{% include 'components/status_badge.html.twig' with {status: model.dataStatus} only %}</span>{% endfor %}
                    </span>
                </label>

                <div class="rtn-field rtn-form-field-full">
                    <details class="rtn-viewer-collapsible" id="rtn-fault-viewer-collapsible">
                        <summary class="rtn-btn rtn-btn-secondary" style="min-height: 44px; display: inline-flex; align-items: center; cursor: pointer; width: auto; margin-bottom: 8px;">
                            {{ icon('boxes', 20) }}
                            <span style="margin-left: 8px;">Choisir sur le schéma 3D</span>
                        </summary>
                        <div style="margin-top: 10px;">
                            {% include '_partials/machine_viewer.html.twig' with {
                                machine: selectedMachine,
                                canSeeTimeline: false
                            } only %}
                        </div>
                    </details>
                </div>

                <label class="rtn-field">
                    <span class="rtn-field-label">Module</span>
                    <select name="fault[module]" class="rtn-input">
                        <option value="">Aucun</option>
                        {% for module in allModules %}<option value="{{ module.id }}" data-machine-model="{{ module.machineModel.id }}" data-model-visible="{{ selectedMachine is null or selectedMachine.machineModel.id == module.machineModel.id ? 'true' : 'false' }}" {% if selectedMachine is not null and selectedMachine.machineModel.id != module.machineModel.id %}hidden{% endif %} {% if data.module|default('') == module.id %}selected{% endif %}>{{ module.machineModel.code }} — {{ module }}</option>{% endfor %}
                    </select>
                    {% if errors.module|default(false) %}<span class="rtn-field-error">{{ errors.module }}</span>{% endif %}
                </label>

                <label class="rtn-field">
                    <span class="rtn-field-label">Pièce</span>
                    <select name="fault[part]" class="rtn-input">
                        <option value="">Aucune</option>
                        {% for part in allParts %}<option value="{{ part.id }}" data-module="{{ part.module.id }}" data-machine-model="{{ part.module.machineModel.id }}" data-model-visible="{{ selectedMachine is null or selectedMachine.machineModel.id == part.module.machineModel.id ? 'true' : 'false' }}" {% if selectedMachine is not null and selectedMachine.machineModel.id != part.module.machineModel.id %}hidden{% endif %} {% if data.part|default('') == part.id %}selected{% endif %}>{{ part.module.machineModel.code }} — {{ part }}</option>{% endfor %}
                    </select>
                    {% if errors.part|default(false) %}<span class="rtn-field-error">{{ errors.part }}</span>{% endif %}
                </label>

                <label class="rtn-field">
                    <span class="rtn-field-label">Symptôme</span>
                    <select name="fault[symptom]" class="rtn-input" required>
                        {% for symptom, knowledge in symptoms %}<option value="{{ symptom }}" {% if data.symptom|default('') == symptom %}selected{% endif %}>{{ symptom }}</option>{% endfor %}
                        <option value="autre" {% if data.symptom|default('') == 'autre' %}selected{% endif %}>Autre</option>
                    </select>
                    {% if errors.symptom|default(false) %}<span class="rtn-field-error">{{ errors.symptom }}</span>{% endif %}
                </label>

                <label class="rtn-field">
                    <span class="rtn-field-label">Gravité</span>
                    <select name="fault[severity]" class="rtn-input" required>
                        <option value="faible" {% if data.severity|default('faible') == 'faible' %}selected{% endif %}>Faible</option>
                        <option value="moyenne" {% if data.severity|default('') == 'moyenne' %}selected{% endif %}>Moyenne</option>
                        <option value="critique" {% if data.severity|default('') == 'critique' %}selected{% endif %}>Critique</option>
                    </select>
                    {% if errors.severity|default(false) %}<span class="rtn-field-error">{{ errors.severity }}</span>{% endif %}
                </label>

                <label class="rtn-field rtn-form-field-full">
                    <span class="rtn-field-label">Description</span>
                    <textarea class="rtn-input" name="fault[description]" rows="4" required>{{ data.description|default('') }}</textarea>
                    {% if errors.description|default(false) %}<span class="rtn-field-error">{{ errors.description }}</span>{% endif %}
                </label>
            </div>

            {% if errors._token|default(false) %}<p class="rtn-field-error" role="alert">{{ errors._token }}</p>{% endif %}
            {% if errors._submission_token|default(false) %}<p class="rtn-field-error" role="alert">{{ errors._submission_token }}</p>{% endif %}

            <div style="margin-top: 16px;">
                <button class="rtn-btn rtn-btn-primary" type="submit" id="rtn-fault-submit">
                    {{ icon('alert-triangle', 18) }}
                    Déclarer la panne
                </button>
            </div>
        </form>

        <aside id="rtn-troubleshooting" class="rtn-troubleshooting" hidden>
            <h2>Causes et solutions du manuel</h2>
            <h3>Causes</h3><ul id="rtn-causes"></ul>
            <h3>Solutions</h3><ul id="rtn-solutions"></ul>
        </aside>

        <div class="rtn-safety">
            <h2>Règles de sécurité</h2>
            <p>Couper et verrouiller les alimentations pneumatique et électrique avant toute intervention. Personnel qualifié uniquement. Utiliser des pièces originales ou validées par ROLTECH.</p>
        </div>
    </section>
</main>

<script>
const rtnTroubleshooting = {{ symptoms|json_encode|raw }};
const rtnSymptomSelect = document.querySelector('select[name="fault[symptom]"]');
const rtnPanel = document.getElementById('rtn-troubleshooting');
const rtnCauses = document.getElementById('rtn-causes');
const rtnSolutions = document.getElementById('rtn-solutions');
const rtnMachineSelect = document.getElementById('rtn-fault-machine');
const rtnFaultForm = document.getElementById('rtn-fault-form');
if (rtnMachineSelect) {
    const rtnModuleSelect = document.querySelector('select[name="fault[module]"]');
    const rtnPartSelect = document.querySelector('select[name="fault[part]"]');
    const rtnFilterOptions = (select, attribute, value) => {
        if (!select) return;
        Array.from(select.options).forEach((option) => {
            const visible = !option.value || option.dataset[attribute] === value;
            option.hidden = !visible;
            option.disabled = !visible;
        });
        if (select.selectedOptions[0]?.disabled) select.value = '';
    };
    const rtnRefreshCatalog = () => {
        const model = rtnMachineSelect.selectedOptions[0]?.dataset.machineModel || '';
        rtnFilterOptions(rtnModuleSelect, 'machineModel', model);
        rtnFilterOptions(rtnPartSelect, 'module', rtnModuleSelect?.value || '');
        document.querySelectorAll('[data-model-badge]').forEach((badge) => {
            badge.hidden = badge.dataset.modelBadge !== model;
        });
    };
    rtnMachineSelect.addEventListener('change', rtnRefreshCatalog);
    rtnModuleSelect?.addEventListener('change', rtnRefreshCatalog);
    rtnRefreshCatalog();
}
if (rtnFaultForm) {
    rtnFaultForm.addEventListener('submit', () => {
        const submitButton = document.getElementById('rtn-fault-submit');
        if (submitButton) {
            submitButton.disabled = true;
            submitButton.textContent = 'Déclaration en cours…';
        }
    }, { once: true });
}
function rtnRenderTroubleshooting() {
    const knowledge = rtnTroubleshooting[rtnSymptomSelect.value];
    rtnCauses.replaceChildren();
    rtnSolutions.replaceChildren();
    if (!knowledge) { rtnPanel.hidden = true; return; }
    knowledge.causes.forEach((cause) => { const item = document.createElement('li'); item.textContent = cause; rtnCauses.append(item); });
    knowledge.solutions.forEach((solution) => { const item = document.createElement('li'); item.textContent = solution; rtnSolutions.append(item); });
    rtnPanel.hidden = false;
}
rtnSymptomSelect.addEventListener('change', rtnRenderTroubleshooting);
rtnRenderTroubleshooting();

// ── Viewer integration for fault form (Step 7.5) ──────────────────────────
const rtnFaultViewerCollapsible = document.getElementById('rtn-fault-viewer-collapsible');
if (rtnFaultViewerCollapsible) {
    // When a module is selected from the 3D viewer or 2D tree, update the dropdowns
    rtnFaultViewerCollapsible.addEventListener('rtn:module-selected', (e) => {
        const moduleId = e.detail?.moduleId;
        const rtnModuleSelect = document.querySelector('select[name="fault[module]"]');
        const rtnPartSelect = document.querySelector('select[name="fault[part]"]');
        if (rtnModuleSelect && moduleId) {
            rtnModuleSelect.value = String(moduleId);
            if (rtnPartSelect) {
                rtnPartSelect.value = '';
            }
            rtnModuleSelect.dispatchEvent(new Event('change', { bubbles: true }));
        }
    });

    // When the machine dropdown changes, update the viewer data URL
    if (rtnMachineSelect) {
        rtnMachineSelect.addEventListener('change', () => {
            const machineId = rtnMachineSelect.value;
            const container = rtnFaultViewerCollapsible.querySelector('[data-rtn-viewer]');
            const wrapper = rtnFaultViewerCollapsible.querySelector('[data-rtn-viewer-wrapper]');
            const noMachineHint = rtnFaultViewerCollapsible.querySelector('[data-rtn-no-machine]');
            if (!container || !wrapper) return;

            const oldUrl = container.dataset.url || null;
            if (machineId) {
                const selectedOpt = rtnMachineSelect.selectedOptions[0];
                const newUrl = selectedOpt?.dataset.viewerUrl || '';
                if (newUrl) {
                    container.dataset.url = newUrl;
                } else {
                    delete container.dataset.url;
                }
                wrapper.dataset.machineId = machineId;
                if (noMachineHint) {
                    noMachineHint.textContent = 'Chargement de la vue 3D…';
                    noMachineHint.classList.remove('rtn-viewer-no-machine');
                }
                // Reinit the panel via the exposed helper (never re-dispatch turbo:load globally)
                if (window._rtnViewerPanel) {
                    window._rtnViewerPanel.reinitWrapper(wrapper, oldUrl);
                }
            } else {
                delete container.dataset.url;
                delete wrapper.dataset.machineId;
                if (oldUrl) {
                    if (window._rtnViewerPanel) {
                        window._rtnViewerPanel.reinitWrapper(wrapper, oldUrl);
                    }
                }
                if (noMachineHint) {
                    noMachineHint.textContent = 'Veuillez sélectionner une machine pour charger la vue 3D.';
                    noMachineHint.classList.add('rtn-viewer-no-machine');
                }
                const detailsContainer = wrapper.querySelector('[data-rtn-panel-details]');
                const emptyHint = wrapper.querySelector('[data-rtn-panel-empty]');
                if (detailsContainer) detailsContainer.hidden = true;
                if (emptyHint) emptyHint.hidden = false;
            }
        });

        // Sync viewer URL if a machine was pre-selected (e.g. browser autofill)
        if (rtnMachineSelect.value) {
            const container = rtnFaultViewerCollapsible.querySelector('[data-rtn-viewer]');
            const wrapper = rtnFaultViewerCollapsible.querySelector('[data-rtn-viewer-wrapper]');
            if (container && !container.dataset.url) {
                const selectedOpt = rtnMachineSelect.selectedOptions[0];
                if (selectedOpt?.dataset.viewerUrl) {
                    container.dataset.url = selectedOpt.dataset.viewerUrl;
                    if (wrapper) wrapper.dataset.machineId = rtnMachineSelect.value;
                    const noMachineHint = rtnFaultViewerCollapsible.querySelector('[data-rtn-no-machine]');
                    if (noMachineHint) {
                        noMachineHint.textContent = 'Chargement de la vue 3D…';
                        noMachineHint.classList.remove('rtn-viewer-no-machine');
                    }
                    if (window._rtnViewerPanel) {
                        window._rtnViewerPanel.reinitWrapper(wrapper);
                    }
                }
            }
        }
    }
}
</script>
{% endblock %}
