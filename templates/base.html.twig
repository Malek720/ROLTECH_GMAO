<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/rtn-ui.css') }}">
            <style>
                .rtn-bell{position:fixed;top:0;right:0;z-index:10;padding:8px 18px;background:#88c0d0;border-radius:0 0 0 8px;box-shadow:0 4px 14px #0006}.rtn-bell a{color:#020817;text-decoration:none}
                .rtn-dashboard-item{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:14px 0;border-bottom:1px solid #3b465c}.rtn-dashboard-item:last-child{border-bottom:0}.rtn-dashboard-item div{display:grid;gap:4px}.rtn-dashboard-item span{color:#d8dee9}
                .rtn-status-grid{display:flex;gap:16px;flex-wrap:wrap}.rtn-status-grid div{display:grid;gap:3px;padding:14px 20px;background:#3b465c;border-radius:10px}.rtn-status-grid strong{font-size:1.6rem;color:#88c0d0}
                .rtn-form{display:grid;gap:20px}.rtn-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 22px}.rtn-form-field-full{grid-column:1/-1}.rtn-form-help{margin:0;color:#d8dee9;font-size:.92rem}
                .rtn-troubleshooting{padding:18px 20px;border:1px solid #4c566a;border-radius:10px;background:#1b2435}.rtn-troubleshooting h2{margin-top:0}.rtn-troubleshooting h3{color:#88c0d0}.rtn-safety{padding-top:8px;border-top:1px solid #3b465c}.rtn-safety h2{margin-bottom:8px}
                .rtn-action-card{display:grid;gap:8px;color:#eceff4!important}.rtn-action-card strong,.rtn-action-card small{color:#eceff4!important}.rtn-action-card span{font-size:2rem;color:#88c0d0}.rtn-filter-active{border-bottom:3px solid #88c0d0;font-weight:700}.rtn-mobile-list{display:grid;gap:10px}.rtn-mobile-list-item{display:grid;gap:7px;padding:16px;border:1px solid #4c566a;border-radius:10px;background:#1b2435;color:#eceff4!important;text-decoration:none}.rtn-page-heading{display:flex;align-items:center;justify-content:space-between;gap:18px}.rtn-detail-list{display:grid;grid-template-columns:minmax(120px,.5fr) minmax(0,1.5fr);gap:10px 18px}.rtn-detail-list dt{font-weight:700;color:#88c0d0}.rtn-detail-list dd{margin:0}.rtn-safety-banner{max-width:1180px;margin:0 auto 20px;padding:20px;background:#4c2b2d;border:2px solid #bf616a;border-radius:14px}.rtn-safety-banner h2{margin-top:0;color:#ffb4ab}.rtn-check-row,.rtn-part-row{display:flex;align-items:center;gap:12px;min-height:48px;padding:10px 0;border-bottom:1px solid #3b465c}.rtn-check-row input{width:24px;height:24px;accent-color:#88c0d0}.rtn-part-row{justify-content:space-between}.rtn-part-row input{width:110px;padding:10px;border:1px solid #4c566a;border-radius:8px;background:#1b2435;color:#eceff4}.rtn-history{display:grid;gap:10px;margin:0;padding-left:22px}.rtn-dashboard-item .rtn-badge{background:#1b2435;color:#eceff4;border:1px solid var(--rtn-badge-color)}
                @media (max-width:700px){.rtn-form-grid{grid-template-columns:1fr}.rtn-form-field-full{grid-column:auto}}
            </style>
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% if app.user %}
            <div class="rtn-bell">
                <a href="{{ path('notifications') }}" data-turbo="false">🔔 Notifications ({{ notification_count() }})</a>
            </div>
            {% include '_partials/global_search.html.twig' %}
        {% endif %}
        {% block body %}{% endblock %}
        {% set flash_messages = app.flashes %}
        {% if flash_messages is not empty %}
            <div class="rtn-toasts" aria-live="polite">
                {% for label, messages in flash_messages %}
                    {% for message in messages %}
                        <div class="rtn-toast rtn-toast-{{ label }}" role="status">
                            <span>{{ message }}</span>
                            <button class="rtn-toast-close" type="button" aria-label="Fermer" onclick="this.parentElement.remove()">×</button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}
    </body>
</html>
