<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <style>
                body{margin:0;background:#020817;color:#eceff4;font-family:system-ui,sans-serif}
                .rtn-dashboard,.rtn-page{min-height:100vh;padding:38px 36px 56px;box-sizing:border-box;background:#020817;color:#eceff4}
                .rtn-dashboard-header{display:flex;justify-content:space-between;align-items:center;gap:24px;margin:0 auto 28px;max-width:1180px}
                .rtn-dashboard-header nav,.rtn-nav{display:flex;gap:18px;flex-wrap:wrap}.rtn-dashboard a,.rtn-page a{color:#88c0d0;text-decoration:none}.rtn-dashboard a:hover,.rtn-page a:hover{color:#b9e6ef;text-decoration:underline}
                .rtn-eyebrow{margin:0;color:#88c0d0;font-weight:700;text-transform:uppercase;letter-spacing:.08em;font-size:.8rem}
                .rtn-dashboard h1{margin:.25rem 0 0;color:#eceff4}.rtn-dashboard-card,.rtn-card{max-width:1180px;margin:0 auto 20px;padding:24px;background:#252d3e;border:1px solid #3b465c;border-radius:14px;box-shadow:0 12px 30px #00000040}
                .rtn-dashboard-grid{max-width:1180px;margin:0 auto 20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:20px}
                .rtn-dashboard-grid .rtn-dashboard-card{margin:0}.rtn-dashboard-number{display:block;font-size:2.4rem;color:#5e81ac}.rtn-dashboard-item{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:14px 0;border-bottom:1px solid #e5e9f0}.rtn-dashboard-item:last-child{border-bottom:0}
                .rtn-dashboard-item div{display:grid;gap:4px}.rtn-dashboard-item span{color:#d8dee9}.rtn-dashboard-item{border-bottom-color:#3b465c}.rtn-pill{padding:5px 10px;border-radius:999px;background:#4c566a;color:#eceff4!important;white-space:nowrap}.rtn-pill-planifiee{background:#5e81ac}.rtn-pill-en-cours{background:#d08770}.rtn-pill-echue{background:#bf616a;color:#fff!important}.rtn-unread{font-weight:600}.rtn-dashboard-link{display:inline-block;margin-top:12px}.rtn-status-grid{display:flex;gap:16px;flex-wrap:wrap}.rtn-status-grid div{display:grid;gap:3px;padding:14px 20px;background:#3b465c;border-radius:10px}.rtn-status-grid strong{font-size:1.6rem;color:#88c0d0}
                .rtn-dashboard-card h2,.rtn-card h2{color:#eceff4}.rtn-dashboard-card p,.rtn-card p,.rtn-card small{color:#d8dee9}
                .rtn-bell{position:fixed;top:0;right:0;z-index:10;padding:8px 18px;background:#88c0d0;border-radius:0 0 0 8px;box-shadow:0 4px 14px #0006}.rtn-bell a{color:#020817;text-decoration:none}
                .rtn-form{display:grid;gap:20px}.rtn-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 22px}.rtn-form-field{display:grid;gap:8px;color:#eceff4;font-weight:600}.rtn-form-field-full{grid-column:1/-1}.rtn-form input,.rtn-form select,.rtn-form textarea{box-sizing:border-box;width:100%;padding:11px 12px;border:1px solid #4c566a;border-radius:8px;background:#1b2435;color:#eceff4;font:inherit}.rtn-form select{cursor:pointer}.rtn-form textarea{min-height:130px;resize:vertical}.rtn-form input:focus,.rtn-form select:focus,.rtn-form textarea:focus{outline:2px solid #88c0d0;outline-offset:1px}.rtn-button{justify-self:start;padding:11px 18px;border:0;border-radius:8px;background:#88c0d0;color:#020817;font-weight:700;cursor:pointer}.rtn-button:hover{background:#b9e6ef}.rtn-form-help{margin:0;color:#d8dee9;font-size:.92rem}.rtn-troubleshooting{padding:18px 20px;border:1px solid #4c566a;border-radius:10px;background:#1b2435}.rtn-troubleshooting h2{margin-top:0}.rtn-troubleshooting h3{color:#88c0d0}.rtn-safety{padding-top:8px;border-top:1px solid #3b465c}.rtn-safety h2{margin-bottom:8px}@media (max-width:700px){.rtn-page{padding:28px 16px 44px}.rtn-form-grid{grid-template-columns:1fr}.rtn-form-field-full{grid-column:auto}}
                .rtn-plan-table{overflow-x:auto;border:1px solid #3b465c;border-radius:10px}.rtn-plan-row{display:grid;grid-template-columns:1.2fr .8fr 1.5fr 1fr .6fr;min-width:760px;gap:12px;padding:13px 16px;border-bottom:1px solid #3b465c}.rtn-plan-row:last-child{border-bottom:0}.rtn-plan-header{font-weight:700;background:#1b2435}.rtn-state-ok{color:#a3be8c}.rtn-state-proche{color:#d08770}.rtn-state-echue{color:#bf616a}
            </style>
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% if app.user %}
            <div class="rtn-bell">
                <a href="{{ path('notifications') }}" data-turbo="false">🔔 Notifications ({{ notification_count() }})</a>
            </div>
        {% endif %}
        {% block body %}{% endblock %}
    </body>
</html>
