{% extends 'shell.html.twig' %}
{% from '_partials/icons.html.twig' import icon %}

{% block title %}Mes interventions — RolTech GMAO{% endblock %}

{% block shell_body %}
<main class="rtn-page rtn-technician-page">
    <header class="rtn-page-header">
        <div>
            <p class="rtn-eyebrow">Espace d'exécution</p>
            <h1 class="rtn-page-title">
                {{ icon('wrench', 28) }}
                Mes interventions
            </h1>
            <p class="rtn-page-desc">Interventions planifiées et en cours assignées à votre compte.</p>
        </div>
        <div class="rtn-actions">
            <a class="rtn-btn rtn-btn-primary rtn-btn-sm" href="{{ path('fault_new') }}" data-turbo="false">
                {{ icon('plus-circle', 18) }}
                Déclarer une panne
            </a>
        </div>
    </header>

    <section class="rtn-card">
        <nav class="rtn-filter-nav" aria-label="Filtrer les interventions" style="margin-bottom:18px;">
            <a class="rtn-touch-link {% if selectedStatus == '' %}rtn-filter-active{% endif %}" href="{{ path('interventions_mine') }}" data-turbo="false">Toutes</a>
            <a class="rtn-touch-link {% if selectedStatus == 'planifiee' %}rtn-filter-active{% endif %}" href="{{ path('interventions_mine', {status: 'planifiee'}) }}" data-turbo="false">Planifiées</a>
            <a class="rtn-touch-link {% if selectedStatus == 'en cours' %}rtn-filter-active{% endif %}" href="{{ path('interventions_mine', {status: 'en cours'}) }}" data-turbo="false">En cours</a>
            <a class="rtn-touch-link {% if selectedStatus == 'terminee' %}rtn-filter-active{% endif %}" href="{{ path('interventions_mine', {status: 'terminee'}) }}" data-turbo="false">Terminées</a>
        </nav>

        <div class="rtn-mobile-list">
            {% for intervention in interventions %}
                {% set machine = intervention.fault ? intervention.fault.machine : intervention.schedule.machine %}
                <a class="rtn-mobile-list-item rtn-item" href="{{ path('intervention_show', {id: intervention.id}) }}" data-turbo="false" style="min-height:52px;text-decoration:none;">
                    <div class="rtn-item-body">
                        <strong>{{ machine }}</strong>
                        <span class="rtn-item-desc">{{ intervention.fault ? intervention.fault.description : intervention.schedule.task.action }}</span>
                    </div>
                    <span>{% include 'components/status_badge.html.twig' with {status: intervention.status} only %}</span>
                </a>
            {% else %}
                <div class="rtn-empty">
                    <span class="rtn-empty-icon" aria-hidden="true">{{ icon('wrench', 40) }}</span>
                    <p>Aucune intervention pour ce filtre.</p>
                </div>
            {% endfor %}
        </div>
    </section>
</main>
{% endblock %}
