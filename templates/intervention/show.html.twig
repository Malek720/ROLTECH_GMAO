{% extends 'base.html.twig' %}

{% block title %}Intervention{% endblock %}

{% block body %}
<main class="rtn-page rtn-technician-page">
    <nav class="rtn-nav">
        <a href="{{ path('interventions_mine') }}" data-turbo="false">Mes interventions</a>
        <a href="{{ path('technicien_dashboard') }}" data-turbo="false">Tableau de bord</a>
    </nav>
    <section class="rtn-card">
        <div class="rtn-page-heading">
            <div>
                <p class="rtn-eyebrow">Intervention #{{ intervention.id }}</p>
                <h1>{{ machine }}</h1>
            </div>
            {% include 'components/status_badge.html.twig' with {status: intervention.status} only %}
        </div>
        {% if error %}<p class="rtn-field-error" role="alert">{{ error }}</p>{% endif %}
        <dl class="rtn-detail-list">
            <dt>Modèle</dt>
            <dd>{{ machine.machineModel.name }} {% if machine.machineModel.dataStatus == 'demo' %}<span class="rtn-demo-badge">Données de démonstration</span>{% endif %}</dd>
            <dt>Type</dt><dd>{% include 'components/status_badge.html.twig' with {status: intervention.type} only %}</dd>
            <dt>Source</dt><dd>{% if intervention.fault %}Panne : {{ intervention.fault.description }}{% else %}Tâche planifiée : {{ intervention.schedule.task.action }}{% endif %}</dd>
            <dt>Module / pièce</dt><dd>{{ intervention.fault and intervention.fault.module ? intervention.fault.module : (intervention.fault and intervention.fault.part ? intervention.fault.part : (intervention.schedule.task.module ?? intervention.schedule.task.part ?? 'Non précisé')) }}</dd>
            <dt>Début</dt><dd>{{ intervention.startedAt ? intervention.startedAt|date('d/m/Y H:i') : 'Pas encore démarrée' }}</dd>
            <dt>Fin</dt><dd>{{ intervention.endDate ? intervention.endDate|date('d/m/Y H:i') : '—' }}</dd>
            <dt>Temps passé</dt><dd>{{ intervention.durationMinutes is not null ? intervention.durationMinutes ~ ' min' : '—' }}</dd>
        </dl>
    </section>

    <section class="rtn-safety rtn-safety-banner" aria-labelledby="safety-title">
        <h2 id="safety-title">Règles de sécurité obligatoires</h2>
        <ul>
            <li>Couper et verrouiller les alimentations électrique et pneumatique.</li>
            <li>Personnel qualifié uniquement.</li>
            <li>Pièces originales ou validées par ROLTECH uniquement.</li>
        </ul>
    </section>

    {% set canAct = is_granted('ROLE_TECHNICIEN') and intervention.technician == app.user %}
    {% if canAct and intervention.status == 'planifiee' %}
        <section class="rtn-card">
            <h2>Démarrer l’intervention</h2>
            <p>Cochez chaque règle avant de commencer.</p>
            <form method="post" action="{{ path('intervention_start', {id: intervention.id}) }}" class="rtn-form">
                <input type="hidden" name="_token" value="{{ csrf_token('intervention_start_' ~ intervention.id) }}">
                {% for key, label in lockoutItems %}
                    <label class="rtn-check-row"><input type="checkbox" name="lockout[]" value="{{ key }}"> <span>{{ label }}</span></label>
                {% endfor %}
                <button class="rtn-button rtn-button-large" type="submit">Démarrer</button>
            </form>
        </section>
    {% endif %}

    {% if canAct and procedureSteps is not empty and intervention.status == 'en cours' %}
        <section class="rtn-card">
            <h2>Procédure</h2>
            <form method="post" action="{{ path('intervention_checklist', {id: intervention.id}) }}" class="rtn-form">
                <input type="hidden" name="_token" value="{{ csrf_token('intervention_checklist_' ~ intervention.id) }}">
                {% for step in procedureSteps %}
                    <label class="rtn-check-row"><input type="checkbox" name="steps[]" value="{{ loop.index0 }}" {% if intervention.checklistProgress[loop.index0] is defined and intervention.checklistProgress[loop.index0] %}checked{% endif %}> <span>{{ step }}</span></label>
                {% endfor %}
                <button class="rtn-button rtn-button-large" type="submit">Enregistrer la progression</button>
            </form>
        </section>
    {% endif %}

    {% if canAct and intervention.status == 'en cours' %}
        <section class="rtn-card">
            <h2>Terminer l’intervention</h2>
            <form method="post" action="{{ path('intervention_complete', {id: intervention.id}) }}" class="rtn-form">
                <input type="hidden" name="_token" value="{{ csrf_token('intervention_complete_' ~ intervention.id) }}">
                <label class="rtn-form-field">Commentaire de fin <textarea name="comment" required minlength="2"></textarea></label>
                {% if availableParts is not empty %}
                    <fieldset class="rtn-form-field">
                        <legend>Pièces remplacées</legend>
                        {% for part in availableParts %}
                            <label class="rtn-part-row">
                                <span>{{ part.description }}{% if part.dataStatus == 'demo' %} — Démo{% endif %}</span>
                                <input type="number" name="parts[{{ part.id }}]" min="1" inputmode="numeric" placeholder="Quantité">
                            </label>
                        {% endfor %}
                    </fieldset>
                {% endif %}
                <button class="rtn-button rtn-button-large" type="submit">Terminer</button>
            </form>
        </section>
    {% endif %}

    {% if canAct and intervention.status in ['planifiee', 'en cours'] %}
        <section class="rtn-card">
            <h2>Je ne peux pas intervenir</h2>
            <form method="post" action="{{ path('intervention_cannot', {id: intervention.id}) }}" class="rtn-form">
                <input type="hidden" name="_token" value="{{ csrf_token('intervention_cannot_' ~ intervention.id) }}">
                <label class="rtn-form-field">Raison <textarea name="reason" required minlength="2"></textarea></label>
                <button class="rtn-button rtn-button-secondary rtn-button-large" type="submit">Renvoyer au dispatch</button>
            </form>
        </section>
    {% endif %}

    <section class="rtn-card">
        <h2>Historique</h2>
        <ul class="rtn-history">
            <li>Créée le {{ intervention.startDate|date('d/m/Y H:i') }}</li>
            {% if intervention.startedAt %}<li>Démarrée le {{ intervention.startedAt|date('d/m/Y H:i') }}</li>{% endif %}
            {% if intervention.endDate %}<li>Terminée le {{ intervention.endDate|date('d/m/Y H:i') }}</li>{% endif %}
            {% if intervention.comment %}<li>{{ intervention.comment }}</li>{% endif %}
        </ul>
    </section>
</main>
{% endblock %}
